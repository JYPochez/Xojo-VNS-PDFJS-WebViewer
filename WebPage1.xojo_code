	#tag EndConstant

	#tag Constant, Name = kFindNoMatch, Type = String, Dynamic = False, Default = \"No match", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kFindResultPrefix, Type = String, Dynamic = False, Default = \"Match ", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kHintPageNumber, Type = String, Dynamic = False, Default = \"Page", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kHintSearch, Type = String, Dynamic = False, Default = \"Text to find", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kHintURL, Type = String, Dynamic = False, Default = \"https://... or /path/to/file.pdf", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kLoadFailedPrefix, Type = String, Dynamic = False, Default = \"Could not load the PDF: ", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kMessagePageOutOfRange, Type = String, Dynamic = False, Default = \"Enter a page number between 1 and ", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kPageLabelNone, Type = String, Dynamic = False, Default = \"No document", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kPageLabelPrefix, Type = String, Dynamic = False, Default = \"Page ", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kPageLabelSeparator, Type = String, Dynamic = False, Default = \" / ", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kPageTitle, Type = String, Dynamic = False, Default = \"VNS PDF.js Viewer", Scope = Private
	#tag EndConstant


#tag EndWindowCode

#tag Events UploaderPDF
	#tag Event
		Sub FileAdded(filename As String, bytes As UInt64, mimeType As String)
		  #Pragma Unused filename
		  #Pragma Unused bytes
		  #Pragma Unused mimeType
		  // Single-file UX: upload as soon as a file is chosen
		  Me.StartUpload
		End Sub
	#tag EndEvent
	#tag Event
		Sub UploadFinished(files() As WebUploadedFile)
		  If files.Count > 0 Then
		    PDFViewerMain.LoadFromData(files(0).Data, files(0).Name)
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonOpenURL
	#tag Event
		Sub Pressed()
		  If Not TextFieldURL.Text.Trim.IsEmpty Then
		    PDFViewerMain.LoadFromURL(TextFieldURL.Text.Trim)
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonCloseDocument
	#tag Event
		Sub Pressed()
		  PDFViewerMain.CloseDocument
		  UpdatePageLabel
		  LabelStatus.Text = ""
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonFirstPage
	#tag Event
		Sub Pressed()
		  PDFViewerMain.FirstPage
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonLastPage
	#tag Event
		Sub Pressed()
		  PDFViewerMain.LastPage
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events TextFieldPageNumber
	#tag Event
		Sub Opening()
		  Me.FieldType = WebTextField.FieldTypes.Number
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonGoToPage
	#tag Event
		Sub Pressed()
		  Var pageNumber As Integer = TextFieldPageNumber.Text.Trim.ToInteger
		  If pageNumber >= 1 And pageNumber <= PDFViewerMain.PageCount Then
		    PDFViewerMain.GoToPage(pageNumber)
		    LabelStatus.Text = ""
		  Else
		    LabelStatus.Text = kMessagePageOutOfRange + PDFViewerMain.PageCount.ToString
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonPreviousPage
	#tag Event
		Sub Pressed()
		  PDFViewerMain.PreviousPage
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonNextPage
	#tag Event
		Sub Pressed()
		  PDFViewerMain.NextPage
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonZoomOut
	#tag Event
		Sub Pressed()
		  PDFViewerMain.ZoomOut
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonZoomIn
	#tag Event
		Sub Pressed()
		  PDFViewerMain.ZoomIn
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonFind
	#tag Event
		Sub Pressed()
		  If Not TextFieldSearch.Text.Trim.IsEmpty Then
		    PDFViewerMain.Find(TextFieldSearch.Text.Trim)
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonFindNext
	#tag Event
		Sub Pressed()
		  PDFViewerMain.FindNext
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events PDFViewerMain
	#tag Event
		Sub DocumentLoaded(pageCount As Integer, title As String)
		  #Pragma Unused pageCount
		  UpdatePageLabel
		  LabelStatus.Text = title
		End Sub
	#tag EndEvent
	#tag Event
		Sub PageChanged(pageNumber As Integer)
		  #Pragma Unused pageNumber
		  UpdatePageLabel
		End Sub
	#tag EndEvent
	#tag Event
		Sub FindResult(currentMatch As Integer, totalMatches As Integer)
		  If totalMatches = 0 Then
		    LabelStatus.Text = kFindNoMatch
		  Else
		    LabelStatus.Text = kFindResultPrefix + currentMatch.ToString + kPageLabelSeparator + totalMatches.ToString
		  End If
		End Sub
	#tag EndEvent
	#tag Event
		Sub LoadFailed(message As String)
		  UpdatePageLabel
		  LabelStatus.Text = kLoadFailedPrefix + message
		End Sub
	#tag EndEvent
#tag EndEvents
