#tag WindowCode
	#tag Method, Flags = &h21
		Private Sub UpdatePageLabel()
		  If PDFViewerMain.PageCount = 0 Then
		    LabelPageInfo.Text = kPageLabelNone
		  Else
		    LabelPageInfo.Text = kPageLabelPrefix + PDFViewerMain.CurrentPage.ToString _
		    + kPageLabelSeparator + PDFViewerMain.PageCount.ToString
		  End If
		End Sub
	#tag EndMethod


	#tag Constant, Name = kAllowedFileTypes, Type = String, Dynamic = False, Default = \"application/pdf\x2C.pdf", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kCaptionClose, Type = String, Dynamic = False, Default = \"Close", Scope = Private
