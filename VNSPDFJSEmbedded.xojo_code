#tag Module
Protected Module VNSPDFJSEmbedded
	#tag Note, Name = About
		Generated from the pdfjs/ folder (PDF.js distribution). Do not edit by hand:
		regenerate it when PDF.js is upgraded (see docs/DEVELOPER_GUIDE.md).
		
		Each PDF.js file is gzip-compressed; FileData returns those compressed bytes
		(MemoryBlock.Decompress restores the file).
	#tag EndNote

	#tag Method, Flags = &h1, Description = 
		Protected Function FileData(relativePath As String) As String
		  If mFiles = Nil Then
		    LoadPack
		  End If
		  
		  Return mFiles.Lookup(relativePath, "")
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21, Description = 4465636F64657320746865207061636B6564205044462E6A7320646973747269627574696F6E20696E746F206D46696C65732E
		Private Sub LoadPack()
		  // Decodes the packed distribution once and indexes every file by its relative path.
		  mFiles = New Dictionary
		  
		  Var packData As String = DecodeBase64(kPackPart01 + kPackPart02 + kPackPart03 + kPackPart04 + kPackPart05)
		  Var entries() As String = kPackIndex.Split(kEntrySeparator)
		  
		  For Each entry As String In entries
		    Var fields() As String = entry.Split(kFieldSeparator)
		    If fields.Count = 3 Then
		      mFiles.Value(fields(0)) = packData.MiddleBytes(fields(1).ToInteger, fields(2).ToInteger)
		    End If
		  Next
		End Sub
	#tag EndMethod

	#tag Property, Flags = &h21
		Private mFiles As Dictionary
	#tag EndProperty


	#tag Constant, Name = kEntrySeparator, Type = String, Dynamic = False, Default = \";", Scope = Private, Description = 5365706172617465732074686520656E7472696573206F66206B5061636B496E6465782E
	#tag EndConstant

	#tag Constant, Name = kFieldSeparator, Type = String, Dynamic = False, Default = \"|", Scope = Private, Description = 53657061726174657320706174682C206F666673657420616E64206C656E67746820696E2061206B5061636B496E64657820656E7472792E
	#tag EndConstant

